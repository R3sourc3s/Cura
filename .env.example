# Required for the frontend's own AI routes (src/app/api/ai/*) — chat,
# compliance-gap-report, risk-score, care-plan-summary, prescription
# transcription. Separate from the backend's Anthropic-based ai_assistant app.
OPENAI_API_KEY=

# Optional — set to enable Sentry error tracking in the frontend (uses the same DSN server- and client-side)
NEXT_PUBLIC_SENTRY_DSN=
