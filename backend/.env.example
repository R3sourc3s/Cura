SECRET_KEY=change-me-generate-a-real-random-key
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CORS_ALLOWED_ORIGINS=http://localhost:3000

# Optional — set to enable the AI assistant backend features (chat, risk score, compliance report)
ANTHROPIC_API_KEY=

# Optional — set to enable Sentry error tracking (same DSN as NEXT_PUBLIC_SENTRY_DSN in the root .env)
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Optional — dev/test email. Leave EMAIL_BACKEND commented out to fall back to
# Django's console backend (prints emails to the terminal instead of sending).
# Sign up free at mailtrap.io for a sandbox inbox that actually renders the
# HTML templates, then fill these in and uncomment EMAIL_BACKEND.
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=sandbox.smtp.mailtrap.io
EMAIL_PORT=2525
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=noreply@curacareplatform.co.uk
